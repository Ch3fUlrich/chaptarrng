<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Disable Chaptarr's implicit test-package group (it currently pulls a coverlet preview chain that fails restore). -->
    <TestProject>false</TestProject>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NunitXml.TestLogger" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Datastore/Fixtures/BookshelfNG.Schema.158.sql" />
    <EmbeddedResource Include="Soulseek/Fixtures/*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NzbDrone.Core\Chaptarr.Core.csproj" />
    <ProjectReference Include="..\Chaptarr.Diagnostics\Chaptarr.Diagnostics.csproj" />
    <ProjectReference Include="..\Chaptarr.Api.V1\Chaptarr.Api.V1.csproj" />
    <ProjectReference Include="..\NzbDrone.Windows\Chaptarr.Windows.csproj" />
    <!-- Composition/ContainerServiceRegistrationFixture builds the container the host builds:
         Bootstrap.ASSEMBLIES lives in Chaptarr.Host, and AssemblyLoader.Load also loads
         Chaptarr.Mono (non-Windows) or Chaptarr.Windows (Windows) by file name. -->
    <ProjectReference Include="..\NzbDrone.Host\Chaptarr.Host.csproj" />
    <ProjectReference Include="..\NzbDrone.Mono\Chaptarr.Mono.csproj" />
  </ItemGroup>
</Project>
